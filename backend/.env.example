# ============================================================
# Fluidity - Configuration du Backend (exemple)
# Copier en .env et renseigner les valeurs réelles
# ============================================================

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/fluidity

# --- JWT ---
JWT_SECRET=changez_ce_secret_en_production_aleatoire
JWT_EXPIRES_IN=7d

# --- Double authentification (2FA / TOTP) ---
# Clé de chiffrement des secrets 2FA (AES-256-GCM) — 32+ caractères aléatoires.
TWO_FACTOR_ENCRYPTION_KEY=changez_cette_cle_2fa_en_production_aleatoire_longue

# --- Serveur ---
PORT=3000

# --- SMTP (Nodemailer) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@company.com
SMTP_PASS=mot_de_passe_email
MAIL_FROM=Fluidity <notifications@company.com>

# --- URLs ---
FRONTEND_URL=http://localhost:4200
