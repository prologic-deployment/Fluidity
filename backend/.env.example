# ============================================================
# Fluidity - Configuration du Backend (exemple)
# Copier en .env et renseigner les valeurs réelles
# ============================================================

# --- MongoDB ---
# IMPORTANT : préférez 127.0.0.1 à « localhost ». Sur Node.js récent / Windows,
# « localhost » peut résoudre d'abord en IPv6 (::1) alors que mongod n'écoute
# qu'en IPv4 — cause classique de connexions lentes ou impossibles.
MONGO_URI=mongodb://127.0.0.1:27017/fluidity

# --- JWT ---
JWT_SECRET=changez_ce_secret_en_production_aleatoire
JWT_EXPIRES_IN=7d

# --- Double authentification (2FA / TOTP) ---
# Clé de chiffrement des secrets 2FA (AES-256-GCM) — 32+ caractères aléatoires.
# OBLIGATOIRE en production : sans elle, une clé dérivée de JWT_SECRET est
# utilisée (avertissement au démarrage). Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=changez_cette_cle_2fa_en_production_aleatoire_longue

# --- Serveur ---
PORT=3000

# --- SMTP (Nodemailer) ---
# Optionnel en développement : tant que SMTP_HOST n'est pas un vrai serveur,
# les emails sont ignorés (un avertissement unique est affiché au démarrage).
# En dev, Mailpit/Mailhog fonctionne très bien (host 127.0.0.1, port 1025).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@company.com
SMTP_PASS=mot_de_passe_email
MAIL_FROM=ServiceDesk <notifications@company.com>

# --- URLs ---
FRONTEND_URL=http://localhost:4200
