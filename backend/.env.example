# ============================================================
# Fluidity - Configuration du Backend (exemple)
# Copier en .env et renseigner les valeurs réelles
# ============================================================

# --- MongoDB ---
# IMPORTANT : préférez 127.0.0.1 à « localhost ». Sur Node.js récent / Windows,
# « localhost » peut résoudre d'abord en IPv6 (::1) alors que mongod n'écoute
# qu'en IPv4 — cause classique de connexions lentes ou impossibles.
MONGO_URI=mongodb://127.0.0.1:27017/fluidity

# --- JWT / Sessions (AUTH-003 : jetons d'accès courts + rotation refresh) ---
# OBLIGATOIRE : plus aucune valeur par défaut en dur dans le code (CFG-003).
JWT_SECRET=changez_ce_secret_en_production_aleatoire
# Durée du jeton d'accès : 15 minutes en production (rafraîchi via le cookie
# httpOnly rotatif « fluidity_rt » ; toute révocation serveur est immédiate).
JWT_EXPIRES_IN=15m
# Durée de vie du jeton de rafraîchissement (jours) — cookie httpOnly rotatif.
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS / Proxy / Journalisation (API-002, LOG-002) ---
# Liste blanche CORS (séparée par des virgules) ; FRONTEND_URL est toujours inclus.
CORS_ORIGINS=
# Nombre de proxies de confiance devant l'API (req.ip réel via X-Forwarded-For).
# Production derrière un reverse proxy : 1. Sans proxy : laisser vide.
TRUST_PROXY_HOPS=
# Niveau de journal structuré JSON : debug | info | warn | error
LOG_LEVEL=info

# --- Seed de démonstration (CFG-001) ---
# Le seed refuse NODE_ENV=production sauf garde-fou explicite :
# SEED_DEMO_IN_PROD=I_UNDERSTAND

# --- Double authentification (2FA / TOTP) ---
# Clé de chiffrement des secrets 2FA (AES-256-GCM) — 32+ caractères aléatoires.
# OBLIGATOIRE en production : sans elle, une clé dérivée de JWT_SECRET est
# utilisée (avertissement au démarrage). Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=changez_cette_cle_2fa_en_production_aleatoire_longue

# --- Serveur ---
PORT=3000

# --- SMTP (Nodemailer) — MAIL-002 (audit) : exigences production ---
# Production : serveur SMTP avec TLS OBLIGATOIRE.
#   * SMTP_SECURE=true  + SMTP_PORT=465 → TLS implicite ;
#   * SMTP_SECURE=false + SMTP_PORT=587 → STARTTLS EXIGÉ (requireTLS) :
#     l'envoi échoue si le serveur ne propose pas STARTTLS (jamais en clair).
# Le certificat du serveur EST vérifié (rejectUnauthorized) : n'utilisez pas
# de certificat auto-signé sans chaîne de confiance valide.
# Délivrabilité : publiez SPF, DKIM et DMARC pour le domaine expéditeur et
# alignez MAIL_FROM sur un domaine authentifié (sinon : rejet/spam).
# Optionnel en développement : tant que SMTP_HOST n'est pas un vrai serveur,
# les emails sont ignorés (un avertissement unique est affiché au démarrage).
# En dev, Mailpit/Mailhog fonctionne très bien (host 127.0.0.1, port 1025).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@company.com
SMTP_PASS=mot_de_passe_email
MAIL_FROM=ServiceDesk <notifications@company.com>

# --- URLs ---
FRONTEND_URL=http://localhost:4200

# --- Politique mot de passe (AUTH-008) ---
# Vérification des mots de passe CHOISIS contre les fuites connues
# (HaveIBeenPwned, k-anonymité : seuls 5 caractères hex du SHA-1 quittent le
# serveur). Fail-open si le service est injoignable. Mettre 0 pour désactiver
# (déploiements hors-ligne).
BREACH_CHECK=1
